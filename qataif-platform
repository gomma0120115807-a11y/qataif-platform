<script>

const SUPABASE_URL='https://pzckkkdqbjodavxqyxhh.supabase.co';

const SUPABASE_KEY='sb_publishable_uzbKO6wxvPkJX-b7edCSJQ_T71vD-xb';

let currentUser=null;

async function sb(path, options={}){

const res=await fetch(
SUPABASE_URL+'/rest/v1/'+path,
{
...options,
headers:{
apikey:SUPABASE_KEY,
Authorization:'Bearer '+SUPABASE_KEY,
'Content-Type':'application/json',
Prefer:'return=representation',
...(options.headers||{})
}
});

if(!res.ok) throw new Error(await res.text());

const txt=await res.text();

return txt?JSON.parse(txt):null;
}

async function auth(path,body){

const res=await fetch(
SUPABASE_URL+'/auth/v1/'+path,
{
method:'POST',
headers:{
apikey:SUPABASE_KEY,
'Content-Type':'application/json'
},
body:JSON.stringify(body)
});

const data=await res.json();

if(!res.ok)
throw new Error(
data.msg||
data.error_description||
data.message||
'حدث خطأ'
);

return data;
}

function setDbStatus(ok,text){

const x=document.getElementById('dbStatus');

x.textContent=text;

x.style.background=ok?'#e8f8f0':'#fff4d8';

x.style.color=ok?'#087a51':'#8a6200';

}

async function initDatabase(){

try{

await sb('courses?select=id&limit=1');

setDbStatus(true,'● قاعدة البيانات متصلة');

await loadCourses();

}catch(e){

setDbStatus(false,'● بانتظار إنشاء الجداول');

}

}

async function loadCourses(){

try{

const rows=await sb('courses?select=*&order=grade.asc');

if(!rows?.length)return;

const cards=[
...document.querySelectorAll('#courses .course')
];

rows.slice(0,3).forEach((c,i)=>{

if(cards[i]){

cards[i].dataset.courseId=c.id;

cards[i].querySelector('h3').textContent=c.title;

cards[i].querySelector('.muted').textContent=
c.description||'شرح وتدريب واختبارات.';

}

});

}catch(e){}

}

function go(id){

document.getElementById(id)?.scrollIntoView({
behavior:'smooth'
});

}

function toast(t){

let x=document.getElementById('toast');

x.textContent=t;

x.style.display='block';

setTimeout(
()=>x.style.display='none',
2400
);

}

async function login(){

const email=prompt(
'اكتب البريد الإلكتروني للطالب:'
);

if(!email)return;

const password=prompt(
'اكتب كلمة المرور:'
);

if(!password)return;

try{

const data=await auth(
'token?grant_type=password',
{
email,
password
}
);

currentUser=data.user;

localStorage.setItem(
'qataif_access_token',
data.access_token
);

toast(
'تم تسجيل الدخول بنجاح يا '+
(data.user?.email||'طالب قطايف')
);

await loadProgress();

}catch(e){

toast(
'تعذر الدخول: '+e.message
);

}

}

async function loadProgress(){

if(!currentUser)return;

try{

const rows=await sb(
'student_progress?student_id=eq.'+
encodeURIComponent(currentUser.id)+
'&select=*'
);

if(rows?.length){

const pct=Number(
rows[0].completion||0
);

document.querySelector(
'.dash .stat b'
).textContent=pct+'%';

document.querySelector(
'.progress i'
).style.width=pct+'%';

}

}catch(e){}

}

